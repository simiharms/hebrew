  { "id": "w13_kle", "no": "kle", "de": "jemandem stehen", "deAlt": ["kleiden"], "pos": "verb", "vf": ["kler", "kledde", "kledd", "kle"], "vg": "4", "lesson": 13, "wk": true, "note": "Den kler deg = Die steht dir. Für die Größe sagt man passe.", "ex": { "no": "Den blå fargen kler deg.", "de": "Die blaue Farbe steht dir." } },
  { "id": "w13_passe", "no": "passe", "de": "passen (Größe)", "pos": "verb", "vf": ["passer", "passet", "passet", "pass"], "vg": "1", "lesson": 13, "wk": true, "ex": { "no": "Støvlene passer perfekt.", "de": "Die Stiefel passen perfekt." } },
  { "id": "w13_klaer", "no": "klær", "de": "die Kleidung", "deAlt": ["die Kleider"], "pos": "noun", "gender": "n", "forms": ["klær", "klærne"], "lesson": 13, "wk": true, "note": "Nur Plural: klær – klærne. Ein einzelnes Stück heißt et plagg.", "ex": { "no": "Jeg trenger varme klær til Tromsø.", "de": "Ich brauche warme Kleidung für Tromsø." } },
  { "id": "w13_plagg", "no": "plagg", "de": "das Kleidungsstück", "pos": "noun", "gender": "n", "forms": ["plagg", "plagget", "plagg", "plagga/plaggene"], "lesson": 13, "wk": true, "ex": { "no": "Hvert plagg koster femti kroner.", "de": "Jedes Kleidungsstück kostet fünfzig Kronen." } },
  { "id": "w13_jakke", "no": "jakke", "de": "die Jacke", "pos": "noun", "gender": "f", "forms": ["jakke", "jakka", "jakker", "jakkene"], "lesson": 13, "wk": true, "ex": { "no": "Jakka mi er altfor tynn.", "de": "Meine Jacke ist viel zu dünn." } },
  { "id": "w13_dunjakke", "no": "dunjakke", "de": "die Daunenjacke", "pos": "noun", "gender": "f", "forms": ["dunjakke", "dunjakka", "dunjakker", "dunjakkene"], "lesson": 13, "wk": true, "ex": { "no": "Er denne dunjakka varm nok?", "de": "Ist diese Daunenjacke warm genug?" } },
  { "id": "w13_vinterjakke", "no": "vinterjakke", "de": "die Winterjacke", "pos": "noun", "gender": "f", "forms": ["vinterjakke", "vinterjakka", "vinterjakker", "vinterjakkene"], "lesson": 13, "wk": true, "ex": { "no": "Jeg ser etter en vinterjakke.", "de": "Ich suche eine Winterjacke." } },
  { "id": "w13_regnjakke", "no": "regnjakke", "de": "die Regenjacke", "pos": "noun", "gender": "f", "forms": ["regnjakke", "regnjakka", "regnjakker", "regnjakkene"], "lesson": 13, "wk": true, "ex": { "no": "I Bergen trenger du ei god regnjakke.", "de": "In Bergen brauchst du eine gute Regenjacke." } },
  { "id": "w13_anorakk", "no": "anorakk", "de": "der Anorak", "pos": "noun", "gender": "m", "forms": ["anorakk", "anorakken", "anorakker", "anorakkene"], "lesson": 13, "wk": true, "ex": { "no": "Anorakken hans er grønn og oransje.", "de": "Sein Anorak ist grün und orange." } },
