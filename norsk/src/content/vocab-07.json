  { "id": "w07_komme_ut", "no": "komme ut", "de": "erscheinen", "deAlt": ["herauskommen"], "pos": "verb", "vf": ["kommer ut", "kom ut", "kommet ut", "kom ut"], "vg": "sterk", "lesson": 7, "ex": { "no": "Boka kom ut i 1879.", "de": "Das Buch erschien 1879." } },
