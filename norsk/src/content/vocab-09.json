  { "id": "w09_forelder", "no": "forelder", "de": "der Elternteil", "deAlt": ["die Eltern"], "pos": "noun", "gender": "m", "forms": ["forelder", "forelderen", "foreldre", "foreldrene"], "lesson": 9, "ex": { "no": "Foreldrene til Matthias bor i Bern.", "de": "Matthias' Eltern wohnen in Bern." }, "note": "Meist im Plural: foreldre = Eltern." },
