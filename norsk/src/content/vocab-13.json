  { "id": "w13_gi_bort", "no": "gi bort", "de": "verschenken, weggeben", "pos": "verb", "vf": ["gir bort", "ga bort", "gitt bort", "gi bort"], "vg": "sterk", "lesson": 13, "ex": { "no": "Vi ga bort de gamle skiene.", "de": "Wir haben die alten Ski verschenkt." } },
