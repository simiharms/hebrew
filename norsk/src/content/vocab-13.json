[
  { "id": "w13_min", "no": "min", "de": "mein", "deAlt": ["meine", "meiner"], "alt": ["mi", "mitt", "mine"], "pos": "pron", "lesson": 13, "note": "min (en-Wort), mi (ei-Wort), mitt (et-Wort), mine (Plural). Meist nachgestellt: genseren min, lua mi.", "ex": { "no": "Genseren min er altfor tynn.", "de": "Mein Pullover ist viel zu dünn." } },
  { "id": "w13_din", "no": "din", "de": "dein", "deAlt": ["deine", "deiner"], "alt": ["di", "ditt", "dine"], "pos": "pron", "lesson": 13, "note": "din, di, ditt, dine – wie min.", "ex": { "no": "Er dette skjerfet ditt?", "de": "Ist das dein Schal?" } },
  { "id": "w13_hans", "no": "hans", "de": "sein", "deAlt": ["seine"], "pos": "pron", "lesson": 13, "note": "Unveränderlich; der Besitzer ist ein Mann.", "ex": { "no": "Anorakken hans er grønn og oransje.", "de": "Sein Anorak ist grün und orange." } },
  { "id": "w13_hennes", "no": "hennes", "de": "ihr (von einer Frau)", "deAlt": ["ihr", "ihre"], "pos": "pron", "lesson": 13, "note": "Unveränderlich; die Besitzerin ist eine Frau.", "ex": { "no": "Det er yndlingsjakka hennes.", "de": "Das ist ihre Lieblingsjacke." } },
  { "id": "w13_vaar", "no": "vår", "de": "unser", "deAlt": ["unsere"], "pos": "pron", "lesson": 13, "note": "vår (en- und ei-Wort), vårt (et-Wort), våre (Plural).", "ex": { "no": "Huset vårt ligger på Sagene.", "de": "Unser Haus liegt in Sagene." } },
  { "id": "w13_deres", "no": "deres", "de": "euer; ihr (von mehreren)", "deAlt": ["euer", "eure", "ihr", "ihre"], "pos": "pron", "lesson": 13, "note": "Unveränderlich. Mit großem D (Deres) = Ihr (Höflichkeitsform, selten).", "ex": { "no": "Hvor er foreldrene deres?", "de": "Wo sind eure Eltern?" } },
  { "id": "w13_dens", "no": "dens", "de": "sein / ihr (von Dingen und Tieren)", "pos": "pron", "lesson": 13, "note": "dens (en/ei-Wort als Besitzer), dets (et-Wort als Besitzer); schriftsprachlich und selten.", "ex": { "no": "Oslo og dens historie", "de": "Oslo und seine Geschichte" } },
  { "id": "w13_loppemarked", "no": "loppemarked", "de": "der Flohmarkt", "pos": "noun", "gender": "n", "forms": ["loppemarked", "loppemarkedet", "loppemarkeder", "loppemarkedene"], "lesson": 13, "ex": { "no": "På lørdag er det loppemarked på skolen.", "de": "Am Samstag ist Flohmarkt in der Schule." } },
  { "id": "w13_dugnad", "no": "dugnad", "de": "die freiwillige Gemeinschaftsarbeit", "pos": "noun", "gender": "m", "forms": ["dugnad", "dugnaden", "dugnader", "dugnadene"], "lesson": 13, "note": "Typisch norwegisch: Nachbarn, Eltern oder Vereinsmitglieder arbeiten unbezahlt zusammen.", "ex": { "no": "I morgen har vi dugnad i borettslaget.", "de": "Morgen haben wir Arbeitseinsatz in der Wohnanlage." } },
  { "id": "w13_korps", "no": "korps", "de": "das Blasorchester, die Musikkapelle", "pos": "noun", "gender": "n", "forms": ["korps", "korpset", "korps", "korpsa/korpsene"], "lesson": 13, "ex": { "no": "Ola spilte trompet i korpset da han var liten.", "de": "Ola hat als Kind in der Kapelle Trompete gespielt." } },
  { "id": "w13_skolekorps", "no": "skolekorps", "de": "die Schulkapelle", "pos": "noun", "gender": "n", "forms": ["skolekorps", "skolekorpset", "skolekorps", "skolekorpsa/skolekorpsene"], "lesson": 13, "ex": { "no": "Skolekorpset går i barnetoget på 17. mai.", "de": "Die Schulkapelle läuft am 17. Mai im Kinderumzug mit." } },
  { "id": "w13_skolegaard", "no": "skolegård", "de": "der Schulhof", "pos": "noun", "gender": "m", "forms": ["skolegård", "skolegården", "skolegårder", "skolegårdene"], "lesson": 13, "ex": { "no": "Hele skolegården var full av bord.", "de": "Der ganze Schulhof war voller Tische." } },
  { "id": "w13_pose", "no": "pose", "de": "die Tüte", "pos": "noun", "gender": "m", "forms": ["pose", "posen", "poser", "posene"], "lesson": 13, "ex": { "no": "Pappa tok feil pose.", "de": "Papa hat die falsche Tüte genommen." } },
  { "id": "w13_ting", "no": "ting", "de": "das Ding, die Sache", "pos": "noun", "gender": "m", "forms": ["ting", "tingen", "ting", "tingene"], "lesson": 13, "note": "Plural ohne Endung: mange ting.", "ex": { "no": "Vi ga bort mange gamle ting.", "de": "Wir haben viele alte Sachen weggegeben." } },
  { "id": "w13_tilbud", "no": "tilbud", "de": "das Angebot", "pos": "noun", "gender": "n", "forms": ["tilbud", "tilbudet", "tilbud", "tilbuda/tilbudene"], "lesson": 13, "ex": { "no": "Det er mitt siste tilbud.", "de": "Das ist mein letztes Angebot." } },
  { "id": "w13_kupp", "no": "kupp", "de": "das Schnäppchen", "pos": "noun", "gender": "n", "forms": ["kupp", "kuppet", "kupp", "kuppa/kuppene"], "lesson": 13, "note": "gjøre et kupp = ein Schnäppchen machen", "ex": { "no": "Jakka kostet bare tretti kroner. For et kupp!", "de": "Die Jacke hat nur dreißig Kronen gekostet. Was für ein Schnäppchen!" } },
  { "id": "w13_avtale", "no": "avtale", "de": "die Abmachung, die Verabredung", "pos": "noun", "gender": "m", "forms": ["avtale", "avtalen", "avtaler", "avtalene"], "lesson": 13, "note": "Avtale! = Abgemacht!", "ex": { "no": "Åtti kroner? Avtale!", "de": "Achtzig Kronen? Abgemacht!" } },
  { "id": "w13_ko", "no": "kø", "de": "die (Warte-)Schlange", "pos": "noun", "gender": "m", "forms": ["kø", "køen", "køer", "køene"], "lesson": 13, "note": "stå i kø = Schlange stehen", "ex": { "no": "Folk sto i kø lenge før loppemarkedet åpnet.", "de": "Die Leute standen lange vor der Öffnung des Flohmarkts Schlange." } },
  { "id": "w13_selger", "no": "selger", "de": "der Verkäufer", "deAlt": ["die Verkäuferin"], "pos": "noun", "gender": "m", "forms": ["selger", "selgeren", "selgere", "selgerne"], "lesson": 13, "ex": { "no": "Selgeren gikk ned på prisen.", "de": "Die Verkäuferin ging mit dem Preis herunter." } },
  { "id": "w13_bruktbutikk", "no": "bruktbutikk", "de": "der Secondhandladen", "pos": "noun", "gender": "m", "forms": ["bruktbutikk", "bruktbutikken", "bruktbutikker", "bruktbutikkene"], "lesson": 13, "ex": { "no": "Jeg kjøpte genseren i en bruktbutikk.", "de": "Ich habe den Pullover in einem Secondhandladen gekauft." } },
  { "id": "w13_gjenbruk", "no": "gjenbruk", "de": "die Wiederverwendung", "deAlt": ["das Recycling"], "pos": "noun", "gender": "n", "forms": ["gjenbruk", "gjenbruket"], "lesson": 13, "ex": { "no": "Loppemarked er gjenbruk.", "de": "Flohmarkt ist Wiederverwendung." } },
  { "id": "w13_nabolag", "no": "nabolag", "de": "die Nachbarschaft", "pos": "noun", "gender": "n", "forms": ["nabolag", "nabolaget", "nabolag", "nabolaga/nabolagene"], "lesson": 13, "ex": { "no": "Hele nabolaget kom på loppemarkedet.", "de": "Die ganze Nachbarschaft kam auf den Flohmarkt." } },
  { "id": "w13_borettslag", "no": "borettslag", "de": "die Wohnungsgenossenschaft", "pos": "noun", "gender": "n", "forms": ["borettslag", "borettslaget", "borettslag", "borettslaga/borettslagene"], "lesson": 13, "ex": { "no": "Borettslaget har dugnad i mai.", "de": "Die Wohnungsgenossenschaft hat im Mai einen Arbeitseinsatz." } },
  { "id": "w13_fellesskap", "no": "fellesskap", "de": "die Gemeinschaft", "pos": "noun", "gender": "n", "forms": ["fellesskap", "fellesskapet", "fellesskap", "fellesskapa/fellesskapene"], "lesson": 13, "ex": { "no": "Dugnad handler om fellesskap.", "de": "Bei einem dugnad geht es um Gemeinschaft." } },
  { "id": "w13_idrettslag", "no": "idrettslag", "de": "der Sportverein", "pos": "noun", "gender": "n", "forms": ["idrettslag", "idrettslaget", "idrettslag", "idrettslaga/idrettslagene"], "lesson": 13, "ex": { "no": "Ola spiller fotball i et idrettslag.", "de": "Ola spielt in einem Sportverein Fußball." } },
  { "id": "w13_lodd", "no": "lodd", "de": "das Los", "pos": "noun", "gender": "n", "forms": ["lodd", "loddet", "lodd", "lodda/loddene"], "lesson": 13, "ex": { "no": "Vil du kjøpe et lodd?", "de": "Möchtest du ein Los kaufen?" } },
  { "id": "w13_leke", "no": "leke", "de": "das Spielzeug", "pos": "noun", "gender": "f", "forms": ["leke", "leka", "leker", "lekene"], "lesson": 13, "ex": { "no": "Det lå mange gamle leker på bordet.", "de": "Auf dem Tisch lag viel altes Spielzeug." } },
  { "id": "w13_mobel", "no": "møbel", "de": "das Möbelstück", "deAlt": ["Möbel"], "pos": "noun", "gender": "n", "forms": ["møbel", "møbelet", "møbler", "møblene"], "lesson": 13, "ex": { "no": "Vi trenger nye møbler til stua.", "de": "Wir brauchen neue Möbel fürs Wohnzimmer." } },
  { "id": "w13_frivillig", "no": "frivillig", "de": "freiwillig", "pos": "adj", "forms": ["frivillig", "frivillig", "frivillige"], "lesson": 13, "ex": { "no": "Alt arbeidet er frivillig.", "de": "Die ganze Arbeit ist freiwillig." } },
  { "id": "w13_prute", "no": "prute", "de": "handeln, feilschen", "pos": "verb", "vf": ["pruter", "prutet", "prutet", "prut"], "vg": "1", "lesson": 13, "ex": { "no": "På loppemarked kan du prute.", "de": "Auf dem Flohmarkt kannst du handeln." } },
  { "id": "w13_gaa_ned_paa_prisen", "no": "gå ned på prisen", "de": "mit dem Preis runtergehen", "pos": "phrase", "lesson": 13, "ex": { "no": "Kan du gå litt ned på prisen?", "de": "Kannst du mit dem Preis etwas runtergehen?" } },
