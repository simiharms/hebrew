  { "id": "w13_genser", "no": "genser", "de": "der Pullover", "pos": "noun", "gender": "m", "forms": ["genser", "genseren", "gensere", "genserne"], "lesson": 13, "wk": true, "ex": { "no": "Det er MIN genser, ikke din!", "de": "Das ist MEIN Pullover, nicht deiner!" } },
