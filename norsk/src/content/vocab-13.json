  { "id": "w13_sortere", "no": "sortere", "de": "sortieren", "pos": "verb", "vf": ["sorterer", "sorterte", "sortert", "sorter"], "vg": "2", "lesson": 13, "ex": { "no": "Foreldrene sorterer klær i flere uker.", "de": "Die Eltern sortieren wochenlang Kleidung." } },
