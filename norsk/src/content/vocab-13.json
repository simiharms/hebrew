  { "id": "w13_lue", "no": "lue", "de": "die Mütze", "pos": "noun", "gender": "f", "forms": ["lue", "lua", "luer", "luene"], "lesson": 13, "wk": true, "ex": { "no": "Jeg finner ikke lua mi.", "de": "Ich finde meine Mütze nicht." } },
  { "id": "w13_vott", "no": "vott", "de": "der Fäustling", "deAlt": ["der Handschuh"], "pos": "noun", "gender": "m", "forms": ["vott", "votten", "votter", "vottene"], "lesson": 13, "wk": true, "ex": { "no": "Du får vottene med på kjøpet.", "de": "Die Fäustlinge bekommst du gratis dazu." } },
  { "id": "w13_hanske", "no": "hanske", "de": "der (Finger-)Handschuh", "pos": "noun", "gender": "m", "forms": ["hanske", "hansken", "hansker", "hanskene"], "lesson": 13, "wk": true, "note": "votter haben nur einen Daumen, hansker fünf Finger.", "ex": { "no": "Med hansker kan du bruke mobilen.", "de": "Mit Fingerhandschuhen kannst du das Handy benutzen." } },
