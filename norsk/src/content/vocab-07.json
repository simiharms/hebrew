[
  { "id": "w07_teater", "no": "teater", "de": "das Theater", "pos": "noun", "gender": "n", "forms": ["teater", "teateret/teatret", "teatre", "teatrene"], "lesson": 7, "ex": { "no": "Vi går i teateret i kveld.", "de": "Wir gehen heute Abend ins Theater." }, "note": "gå i teateret / gå på teater = ins Theater gehen" },
  { "id": "w07_sjalusi", "no": "sjalusi", "de": "die Eifersucht", "pos": "noun", "gender": "m", "forms": ["sjalusi", "sjalusien"], "lesson": 7, "wk": true, "ex": { "no": "Sjalusi er en vond følelse.", "de": "Eifersucht ist ein schlimmes Gefühl." } },
  { "id": "w07_endelig", "no": "endelig", "de": "endlich", "pos": "adv", "lesson": 7, "ex": { "no": "Endelig er det fredag!", "de": "Endlich ist Freitag!" } },
  { "id": "w07_pause", "no": "pause", "de": "die Pause", "pos": "noun", "gender": "m", "forms": ["pause", "pausen", "pauser", "pausene"], "lesson": 7, "ex": { "no": "I pausen drikker vi kaffe.", "de": "In der Pause trinken wir Kaffee." } },
  { "id": "w07_stykke", "no": "stykke", "de": "das (Theater-)Stück", "deAlt": ["das Stück", "das Theaterstück"], "pos": "noun", "gender": "n", "forms": ["stykke", "stykket", "stykker", "stykkene"], "lesson": 7, "ex": { "no": "Stykket er av Henrik Ibsen.", "de": "Das Stück ist von Henrik Ibsen." }, "note": "Auch: et stykke kake = ein Stück Kuchen." },
  { "id": "w07_saa_langt", "no": "så langt", "de": "bis jetzt, bisher", "pos": "phrase", "lesson": 7, "ex": { "no": "Så langt liker jeg kurset veldig godt.", "de": "Bis jetzt gefällt mir der Kurs sehr gut." } },
  { "id": "w07_for", "no": "før", "de": "vorher, schon einmal", "deAlt": ["früher", "vorher"], "pos": "adv", "lesson": 7, "ex": { "no": "Har du sett stykket før?", "de": "Hast du das Stück schon einmal gesehen?" }, "note": "Auch Präposition: før pausen = vor der Pause." },
  { "id": "w07_videregaaende_skole", "no": "videregående skole", "de": "die Oberstufe, das Gymnasium", "pos": "phrase", "lesson": 7, "ex": { "no": "Ola går på videregående skole.", "de": "Ola geht in die Oberstufe." }, "note": "Die Schule für 16- bis 19-Jährige; oft nur »videregående«." },
  { "id": "w07_scene", "no": "scene", "de": "die Bühne", "deAlt": ["die Szene"], "pos": "noun", "gender": "m", "forms": ["scene", "scenen", "scener", "scenene"], "lesson": 7, "ex": { "no": "Skuespillerne står på scenen.", "de": "Die Schauspieler stehen auf der Bühne." } },
  { "id": "w07_skuespiller", "no": "skuespiller", "de": "der Schauspieler / die Schauspielerin", "deAlt": ["der Schauspieler", "die Schauspielerin"], "pos": "noun", "gender": "m", "forms": ["skuespiller", "skuespilleren", "skuespillere", "skuespillerne"], "lesson": 7, "ex": { "no": "Hun er skuespiller på Nationaltheatret.", "de": "Sie ist Schauspielerin am Nationaltheatret." }, "note": "Für Männer und Frauen." },
  { "id": "w07_spille", "no": "spille", "de": "spielen", "pos": "verb", "vf": ["spiller", "spilte", "spilt", "spill"], "vg": "2", "lesson": 7, "ex": { "no": "Hvem spiller Nora i kveld?", "de": "Wer spielt heute Abend Nora?" } },
  { "id": "w07_utrolig", "no": "utrolig", "de": "unglaublich", "pos": "adj", "forms": ["utrolig", "utrolig", "utrolige"], "lesson": 7, "ex": { "no": "Hun er utrolig flink.", "de": "Sie ist unglaublich gut." }, "note": "Auch als Verstärkung: utrolig god = unglaublich gut." },
  { "id": "w07_flink", "no": "flink", "de": "tüchtig, gut (in etwas)", "deAlt": ["begabt", "geschickt", "tüchtig"], "pos": "adj", "forms": ["flink", "flinkt", "flinke"], "lesson": 7, "ex": { "no": "Anna er flink til å lage mat.", "de": "Anna kann gut kochen." }, "note": "flink til = gut in: Han er flink til å synge." },
  { "id": "w07_hente", "no": "hente", "de": "holen, abholen", "pos": "verb", "vf": ["henter", "hentet", "hentet", "hent"], "vg": "1", "lesson": 7, "ex": { "no": "Jonas henter kaffe til alle.", "de": "Jonas holt Kaffee für alle." } },
  { "id": "w07_ko", "no": "kø", "de": "die (Warte-)Schlange", "pos": "noun", "gender": "m", "forms": ["kø", "køen", "køer", "køene"], "lesson": 7, "ex": { "no": "Jeg har stått i kø i ti minutter.", "de": "Ich habe zehn Minuten in der Schlange gestanden." }, "note": "stå i kø = Schlange stehen" },
  { "id": "w07_snill", "no": "snill", "de": "lieb, nett", "deAlt": ["freundlich", "brav"], "pos": "adj", "forms": ["snill", "snilt", "snille"], "lesson": 7, "ex": { "no": "Så snilt av deg!", "de": "Wie lieb von dir!" }, "note": "Neutrum mit einem l: snilt (Lektion 5)." },
  { "id": "w07_rolle", "no": "rolle", "de": "die Rolle", "pos": "noun", "gender": "m", "forms": ["rolle", "rollen", "roller", "rollene"], "lesson": 7, "ex": { "no": "Nora er en stor rolle.", "de": "Nora ist eine große Rolle." } },
  { "id": "w07_selvfolgelig", "no": "selvfølgelig", "de": "natürlich, selbstverständlich", "pos": "adv", "lesson": 7, "ex": { "no": "Selvfølgelig kommer jeg!", "de": "Natürlich komme ich!" } },
  { "id": "w07_sterk", "no": "sterk", "de": "stark", "pos": "adj", "forms": ["sterk", "sterkt", "sterke"], "lesson": 7, "ex": { "no": "Nora er en sterk kvinne.", "de": "Nora ist eine starke Frau." } },
  { "id": "w07_ennaa", "no": "ennå", "de": "noch", "pos": "adv", "lesson": 7, "ex": { "no": "Jeg har ikke lest boka ennå.", "de": "Ich habe das Buch noch nicht gelesen." }, "note": "ikke ennå = noch nicht" },
  { "id": "w07_akkurat", "no": "akkurat", "de": "genau", "deAlt": ["gerade"], "pos": "adv", "lesson": 7, "ex": { "no": "Akkurat! Det mener jeg også.", "de": "Genau! Das meine ich auch." }, "note": "akkurat nå = gerade jetzt" },
  { "id": "w07_behandle", "no": "behandle", "de": "behandeln", "pos": "verb", "vf": ["behandler", "behandlet", "behandlet", "behandle"], "vg": "1", "lesson": 7, "ex": { "no": "Torvald behandler Nora som et barn.", "de": "Torvald behandelt Nora wie ein Kind." } },
  { "id": "w07_slutt", "no": "slutt", "de": "der Schluss, das Ende", "deAlt": ["der Schluss", "das Ende"], "pos": "noun", "gender": "m", "forms": ["slutt", "slutten", "slutter", "sluttene"], "lesson": 7, "ex": { "no": "Slutten av stykket er veldig sterk.", "de": "Der Schluss des Stücks ist sehr stark." }, "note": "til slutt = am Ende, schließlich" },
  { "id": "w07_slutte", "no": "slutte", "de": "enden, aufhören", "deAlt": ["enden", "aufhören"], "pos": "verb", "vf": ["slutter", "sluttet", "sluttet", "slutt"], "vg": "1", "lesson": 7, "ex": { "no": "Jeg vil ikke vite hvordan filmen slutter.", "de": "Ich will nicht wissen, wie der Film ausgeht." } },
  { "id": "w07_ringe", "no": "ringe", "de": "klingeln; anrufen", "deAlt": ["klingeln", "anrufen", "läuten"], "pos": "verb", "vf": ["ringer", "ringte", "ringt", "ring"], "vg": "2", "lesson": 7, "ex": { "no": "Nå ringer det – pausen er over.", "de": "Jetzt klingelt es – die Pause ist vorbei." } },
  { "id": "w07_igjen", "no": "igjen", "de": "wieder", "pos": "adv", "lesson": 7, "ex": { "no": "Vi må gå inn igjen.", "de": "Wir müssen wieder hineingehen." }, "note": "Auch »zu«: smelle igjen døra = die Tür zuknallen." },
  { "id": "w07_dor", "no": "dør", "de": "die Tür", "pos": "noun", "gender": "f", "forms": ["dør", "døra/døren", "dører", "dørene"], "lesson": 7, "ex": { "no": "Kan du lukke døra?", "de": "Kannst du die Tür zumachen?" } },
  { "id": "w07_smelle", "no": "smelle", "de": "knallen", "pos": "verb", "vf": ["smeller", "smalt", "smelt", "smell"], "vg": "sterk", "lesson": 7, "ex": { "no": "Nora smeller igjen døra.", "de": "Nora knallt die Tür zu." }, "note": "smelle igjen døra = die Tür zuknallen" },
  { "id": "w07_smell", "no": "smell", "de": "der Knall", "pos": "noun", "gender": "n", "forms": ["smell", "smellet", "smell", "smella/smellene"], "lesson": 7, "ex": { "no": "Vi hørte et høyt smell.", "de": "Wir hörten einen lauten Knall." } },
  { "id": "w07_folk", "no": "folk", "de": "die Leute", "deAlt": ["das Volk"], "pos": "noun", "gender": "n", "forms": ["folk", "folket", "folk", "folka/folkene"], "lesson": 7, "ex": { "no": "Folk snakker fortsatt om stykket.", "de": "Die Leute reden immer noch über das Stück." }, "note": "folk (ohne Artikel) = Leute; et folk = ein Volk." },
  { "id": "w07_siden", "no": "siden", "de": "seit", "pos": "prep", "lesson": 7, "ex": { "no": "Jeg har bodd i Oslo siden august.", "de": "Ich wohne seit August in Oslo." }, "note": "siden + Zeitpunkt; für eine Dauer: i (i tre uker)." },
  { "id": "w07_moderne", "no": "moderne", "de": "modern", "pos": "adj", "forms": ["moderne", "moderne", "moderne"], "lesson": 7, "ex": { "no": "Stykket er gammelt, men veldig moderne.", "de": "Das Stück ist alt, aber sehr modern." }, "note": "Unveränderlich." },
  { "id": "w07_samtidig", "no": "samtidig", "de": "gleichzeitig", "deAlt": ["zugleich"], "pos": "adv", "lesson": 7, "ex": { "no": "Jeg kan ikke lese og snakke samtidig.", "de": "Ich kann nicht gleichzeitig lesen und reden." } },
  { "id": "w07_ingenting", "no": "ingenting", "de": "nichts", "pos": "pron", "lesson": 7, "ex": { "no": "Jeg forstår ingenting!", "de": "Ich verstehe nichts!" } },
  { "id": "w07_ha_det_hyggelig", "no": "ha det hyggelig", "de": "es nett haben, sich gut unterhalten", "pos": "phrase", "lesson": 7, "ex": { "no": "Har dere hatt det hyggelig i kveld?", "de": "Hattet ihr einen schönen Abend?" } },
  { "id": "w07_sjalu", "no": "sjalu", "de": "eifersüchtig", "pos": "adj", "lesson": 7, "wk": true, "ex": { "no": "Jonas er sjalu på Matthias.", "de": "Jonas ist eifersüchtig auf Matthias." }, "note": "sjalu på = eifersüchtig auf. Die Form bleibt meist unverändert: et sjalu blikk." },
  { "id": "w07_kvarter", "no": "kvarter", "de": "die Viertelstunde", "pos": "noun", "gender": "n", "forms": ["kvarter", "kvarteret", "kvarter", "kvartera/kvarterene"], "lesson": 7, "ex": { "no": "De snakket i et kvarter.", "de": "Sie redeten eine Viertelstunde lang." }, "note": "et kvarter = 15 Minuten. Bei der Uhrzeit: kvart over tre (Lektion 8)." },
  { "id": "w07_kaffekopp", "no": "kaffekopp", "de": "die Kaffeetasse", "pos": "noun", "gender": "m", "forms": ["kaffekopp", "kaffekoppen", "kaffekopper", "kaffekoppene"], "lesson": 7, "ex": { "no": "Jonas sto der med fire kaffekopper.", "de": "Jonas stand da mit vier Kaffeetassen." } },
  { "id": "w07_love", "no": "love", "de": "versprechen", "pos": "verb", "vf": ["lover", "lovet", "lovet", "lov"], "vg": "1", "lesson": 7, "ex": { "no": "Jeg lover å komme i morgen.", "de": "Ich verspreche, morgen zu kommen." } },
  { "id": "w07_noen_gang", "no": "noen gang", "de": "jemals, schon einmal", "pos": "phrase", "lesson": 7, "ex": { "no": "Har du noen gang vært i Bergen?", "de": "Warst du schon einmal in Bergen?" } },
  { "id": "w07_forfatter", "no": "forfatter", "de": "der Schriftsteller / die Schriftstellerin", "deAlt": ["der Schriftsteller", "der Autor", "die Autorin"], "pos": "noun", "gender": "m", "forms": ["forfatter", "forfatteren", "forfattere", "forfatterne"], "lesson": 7, "ex": { "no": "Ibsen er en kjent norsk forfatter.", "de": "Ibsen ist ein bekannter norwegischer Schriftsteller." } },
  { "id": "w07_dod", "no": "død", "de": "tot", "pos": "adj", "forms": ["død", "dødt", "døde"], "lesson": 7, "ex": { "no": "Ibsen har vært død i over hundre år.", "de": "Ibsen ist seit über hundert Jahren tot." } },
  { "id": "w07_do", "no": "dø", "de": "sterben", "pos": "verb", "vf": ["dør", "døde", "dødd", "dø"], "vg": "uregelm", "lesson": 7, "ex": { "no": "Ibsen døde i 1906.", "de": "Ibsen starb 1906." }, "note": "Achtung: han dør = er stirbt, aber ei dør = eine Tür." },
  { "id": "w07_glad", "no": "glad", "de": "froh, fröhlich", "pos": "adj", "forms": ["glad", "glad", "glade"], "lesson": 7, "wk": true, "ex": { "no": "Anna er glad i dag.", "de": "Anna ist heute fröhlich." }, "note": "Falscher Freund: glad = froh (nicht »glatt«). Neutrum ohne -t: et glad barn." },
  { "id": "w07_glad_i", "no": "glad i", "de": "gern haben, lieb haben", "pos": "phrase", "lesson": 7, "wk": true, "ex": { "no": "Jeg er glad i deg.", "de": "Ich hab dich lieb." } },
  { "id": "w07_sur", "no": "sur", "de": "sauer; schlecht gelaunt", "deAlt": ["sauer", "schlecht gelaunt", "mürrisch"], "pos": "adj", "forms": ["sur", "surt", "sure"], "lesson": 7, "wk": true, "ex": { "no": "Jonas var sur hele kvelden.", "de": "Jonas war den ganzen Abend schlecht gelaunt." } },
  { "id": "w07_ha_lyst_paa", "no": "ha lyst på", "de": "Lust haben auf", "pos": "phrase", "lesson": 7, "ex": { "no": "Har du lyst på pizza?", "de": "Hast du Lust auf Pizza?" } },
  { "id": "w07_spandere", "no": "spandere", "de": "spendieren, einladen", "deAlt": ["ausgeben", "einladen"], "pos": "verb", "vf": ["spanderer", "spanderte", "spandert", "spander"], "vg": "2", "lesson": 7, "ex": { "no": "Jeg spanderer kaffe på alle.", "de": "Ich lade alle zum Kaffee ein." }, "note": "spandere noe på noen = jemandem etwas spendieren" },
  { "id": "w07_sent", "no": "sent", "de": "spät", "pos": "adv", "lesson": 7, "ex": { "no": "Det er sent. Vi må gå hjem.", "de": "Es ist spät. Wir müssen nach Hause gehen." } },
  { "id": "w07_like_ved", "no": "like ved", "de": "ganz in der Nähe von", "pos": "phrase", "lesson": 7, "ex": { "no": "Kafeen ligger like ved teateret.", "de": "Das Café liegt ganz in der Nähe des Theaters." } },
  { "id": "w07_stortinget", "no": "Stortinget", "de": "das Storting (das norwegische Parlament)", "pos": "name", "lesson": 7, "ex": { "no": "Stortinget ligger i Karl Johans gate.", "de": "Das Storting liegt an der Karl Johans gate." } },
  { "id": "w07_fortelle", "no": "fortelle", "de": "erzählen", "pos": "verb", "vf": ["forteller", "fortalte", "fortalt", "fortell"], "vg": "uregelm", "lesson": 7, "ex": { "no": "Det forteller jeg deg en annen gang.", "de": "Das erzähle ich dir ein andermal." } },
  { "id": "w07_gang", "no": "gang", "de": "das Mal", "pos": "noun", "gender": "m", "forms": ["gang", "gangen", "ganger", "gangene"], "lesson": 7, "ex": { "no": "Vi kan snakke om det en annen gang.", "de": "Wir können ein andermal darüber reden." }, "note": "en gang = einmal; to ganger = zweimal; en annen gang = ein andermal; noen gang = jemals." },
  { "id": "w07_kjaereste", "no": "kjæreste", "de": "der (feste) Freund / die (feste) Freundin", "deAlt": ["der Freund", "die Freundin", "der Partner", "die Partnerin"], "pos": "noun", "gender": "m", "forms": ["kjæreste", "kjæresten", "kjærester", "kjærestene"], "lesson": 7, "wk": true, "ex": { "no": "Anna og Jonas har vært kjærester i to år.", "de": "Anna und Jonas sind seit zwei Jahren ein Paar." }, "note": "en venn = ein Freund (Freundschaft); en kjæreste = Partner/in." },
  { "id": "w07_folelse", "no": "følelse", "de": "das Gefühl", "pos": "noun", "gender": "m", "forms": ["følelse", "følelsen", "følelser", "følelsene"], "lesson": 7, "wk": true, "ex": { "no": "Glede er en god følelse.", "de": "Freude ist ein gutes Gefühl." } },
  { "id": "w07_fole_seg", "no": "føle seg", "de": "sich fühlen", "pos": "verb", "vf": ["føler seg", "følte seg", "følt seg", "føl deg"], "vg": "2", "lesson": 7, "wk": true, "ex": { "no": "Hvordan føler du deg i dag?", "de": "Wie fühlst du dich heute?" } },
  { "id": "w07_elske", "no": "elske", "de": "lieben", "pos": "verb", "vf": ["elsker", "elsket", "elsket", "elsk"], "vg": "1", "lesson": 7, "wk": true, "ex": { "no": "Jeg elsker teater!", "de": "Ich liebe Theater!" }, "note": "Auch für Dinge: Jeg elsker brunost." },
  { "id": "w07_forelsket", "no": "forelsket", "de": "verliebt", "pos": "adj", "forms": ["forelsket", "forelsket", "forelskede"], "lesson": 7, "wk": true, "ex": { "no": "Matthias er kanskje forelsket i Susanne.", "de": "Matthias ist vielleicht in Susanne verliebt." }, "note": "forelsket i = verliebt in" },
  { "id": "w07_sint", "no": "sint", "de": "wütend, böse", "pos": "adj", "forms": ["sint", "sint", "sinte"], "lesson": 7, "wk": true, "ex": { "no": "Er du sint på meg?", "de": "Bist du wütend auf mich?" }, "note": "sint på = wütend auf" },
  { "id": "w07_vaere_lei_seg", "no": "være lei seg", "de": "traurig sein; etwas bedauern", "deAlt": ["traurig sein", "leidtun"], "pos": "phrase", "lesson": 7, "wk": true, "ex": { "no": "Anna er lei seg fordi Jonas er sur.", "de": "Anna ist traurig, weil Jonas schlecht gelaunt ist." } },
  { "id": "w07_vaere_lei_av", "no": "være lei av", "de": "etwas satthaben", "pos": "phrase", "lesson": 7, "wk": true, "ex": { "no": "Jeg er lei av regn.", "de": "Ich habe den Regen satt." } },
  { "id": "w07_redd", "no": "redd", "de": "ängstlich", "deAlt": ["Angst haben"], "pos": "adj", "forms": ["redd", "redd", "redde"], "lesson": 7, "wk": true, "ex": { "no": "Er du redd for mørket?", "de": "Hast du Angst vor der Dunkelheit?" }, "note": "være redd for = Angst haben vor" },
  { "id": "w07_nervos", "no": "nervøs", "de": "nervös", "pos": "adj", "forms": ["nervøs", "nervøst", "nervøse"], "lesson": 7, "wk": true, "ex": { "no": "Jeg er alltid nervøs før en eksamen.", "de": "Vor einer Prüfung bin ich immer nervös." } },
  { "id": "w07_skuffet", "no": "skuffet", "de": "enttäuscht", "pos": "adj", "forms": ["skuffet", "skuffet", "skuffede"], "lesson": 7, "wk": true, "ex": { "no": "Ola er skuffet fordi laget tapte.", "de": "Ola ist enttäuscht, weil die Mannschaft verloren hat." } },
  { "id": "w07_stolt", "no": "stolt", "de": "stolz", "pos": "adj", "forms": ["stolt", "stolt", "stolte"], "lesson": 7, "wk": true, "ex": { "no": "Kari er stolt av Anna.", "de": "Kari ist stolz auf Anna." }, "note": "stolt av (nicht på!)" },
  { "id": "w07_kjede_seg", "no": "kjede seg", "de": "sich langweilen", "pos": "verb", "vf": ["kjeder seg", "kjedet seg", "kjedet seg", "kjed deg"], "vg": "1", "lesson": 7, "wk": true, "ex": { "no": "Ola kjeder seg i teateret.", "de": "Ola langweilt sich im Theater." } },
  { "id": "w07_lettet", "no": "lettet", "de": "erleichtert", "pos": "adj", "forms": ["lettet", "lettet", "lettede"], "lesson": 7, "wk": true, "ex": { "no": "Anna er lettet, og Jonas smiler igjen.", "de": "Anna ist erleichtert, und Jonas lächelt wieder." } },
  { "id": "w07_rorende", "no": "rørende", "de": "rührend", "pos": "adj", "forms": ["rørende", "rørende", "rørende"], "lesson": 7, "wk": true, "ex": { "no": "Slutten var veldig rørende.", "de": "Der Schluss war sehr rührend." } },
  { "id": "w07_ensom", "no": "ensom", "de": "einsam", "pos": "adj", "forms": ["ensom", "ensomt", "ensomme"], "lesson": 7, "wk": true, "ex": { "no": "Nora føler seg ensom.", "de": "Nora fühlt sich einsam." }, "note": "Plural mit mm: ensomme (Lektion 5)." },
  { "id": "w07_bli_fodt", "no": "bli født", "de": "geboren werden", "pos": "phrase", "lesson": 7, "ex": { "no": "Jeg ble født i Freiburg.", "de": "Ich bin in Freiburg geboren." }, "note": "»Ich bin … geboren« heißt Jeg ble født …" },
  { "id": "w07_flytte", "no": "flytte", "de": "umziehen, ziehen", "pos": "verb", "vf": ["flytter", "flyttet", "flyttet", "flytt"], "vg": "1", "lesson": 7, "ex": { "no": "Susanne flytter til Tromsø i november.", "de": "Susanne zieht im November nach Tromsø." } },
  { "id": "w07_apotek", "no": "apotek", "de": "die Apotheke", "pos": "noun", "gender": "n", "forms": ["apotek", "apoteket", "apotek", "apoteka/apotekene"], "lesson": 7, "ex": { "no": "Ibsen arbeidet på et apotek i Grimstad.", "de": "Ibsen arbeitete in einer Apotheke in Grimstad." } },
