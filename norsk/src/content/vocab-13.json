  { "id": "w13_bukse", "no": "bukse", "de": "die Hose", "pos": "noun", "gender": "f", "forms": ["bukse", "buksa", "bukser", "buksene"], "lesson": 13, "wk": true, "ex": { "no": "Buksa er for trang.", "de": "Die Hose ist zu eng." } },
  { "id": "w13_olabukse", "no": "olabukse", "de": "die Jeans", "pos": "noun", "gender": "f", "forms": ["olabukse", "olabuksa", "olabukser", "olabuksene"], "lesson": 13, "wk": true, "ex": { "no": "Ola går alltid i olabukse.", "de": "Ola trägt immer Jeans." } },
  { "id": "w13_skjorte", "no": "skjorte", "de": "das Hemd", "pos": "noun", "gender": "f", "forms": ["skjorte", "skjorta", "skjorter", "skjortene"], "lesson": 13, "wk": true, "ex": { "no": "Per har på seg ei hvit skjorte.", "de": "Per trägt ein weißes Hemd." } },
  { "id": "w13_bluse", "no": "bluse", "de": "die Bluse", "pos": "noun", "gender": "m", "forms": ["bluse", "blusen", "bluser", "blusene"], "lesson": 13, "wk": true, "ex": { "no": "Blusen er av bomull.", "de": "Die Bluse ist aus Baumwolle." } },
  { "id": "w13_kjole", "no": "kjole", "de": "das Kleid", "pos": "noun", "gender": "m", "forms": ["kjole", "kjolen", "kjoler", "kjolene"], "lesson": 13, "wk": true, "ex": { "no": "Anna kjøpte en rød kjole.", "de": "Anna hat ein rotes Kleid gekauft." } },
  { "id": "w13_skjort", "no": "skjørt", "de": "der Rock", "pos": "noun", "gender": "n", "forms": ["skjørt", "skjørtet", "skjørt", "skjørta/skjørtene"], "lesson": 13, "wk": true, "note": "Nicht verwechseln: et skjørt = der Rock, ei skjorte = das Hemd.", "ex": { "no": "Skjørtet er for kort.", "de": "Der Rock ist zu kurz." } },
  { "id": "w13_t_skjorte", "no": "t-skjorte", "de": "das T-Shirt", "pos": "noun", "gender": "f", "forms": ["t-skjorte", "t-skjorta", "t-skjorter", "t-skjortene"], "lesson": 13, "wk": true, "ex": { "no": "I Tromsø trenger jeg ikke mange t-skjorter.", "de": "In Tromsø brauche ich nicht viele T-Shirts." } },
  { "id": "w13_sokk", "no": "sokk", "de": "die Socke", "pos": "noun", "gender": "m", "forms": ["sokk", "sokken", "sokker", "sokkene"], "lesson": 13, "wk": true, "ex": { "no": "Det er hull i sokken min.", "de": "In meiner Socke ist ein Loch." } },
  { "id": "w13_ullsokk", "no": "ullsokk", "de": "die Wollsocke", "pos": "noun", "gender": "m", "forms": ["ullsokk", "ullsokken", "ullsokker", "ullsokkene"], "lesson": 13, "wk": true, "ex": { "no": "Bestemor strikker ullsokker til hele familien.", "de": "Oma strickt Wollsocken für die ganze Familie." } },
  { "id": "w13_undertoy", "no": "undertøy", "de": "die Unterwäsche", "pos": "noun", "gender": "n", "forms": ["undertøy", "undertøyet"], "lesson": 13, "wk": true, "ex": { "no": "Jeg må kjøpe nytt undertøy.", "de": "Ich muss neue Unterwäsche kaufen." } },
  { "id": "w13_ullundertoy", "no": "ullundertøy", "de": "die Wollunterwäsche", "pos": "noun", "gender": "n", "forms": ["ullundertøy", "ullundertøyet"], "lesson": 13, "wk": true, "note": "Im norwegischen Winter gilt: Wolle direkt auf der Haut (ull innerst).", "ex": { "no": "Med ullundertøy fryser du ikke.", "de": "Mit Wollunterwäsche frierst du nicht." } },
  { "id": "w13_sko", "no": "sko", "de": "der Schuh", "pos": "noun", "gender": "m", "forms": ["sko", "skoen", "sko", "skoene"], "lesson": 13, "wk": true, "note": "Plural ohne Endung: to sko.", "ex": { "no": "Har du sett skoene mine?", "de": "Hast du meine Schuhe gesehen?" } },
  { "id": "w13_stovel", "no": "støvel", "de": "der Stiefel", "pos": "noun", "gender": "m", "forms": ["støvel", "støvelen", "støvler", "støvlene"], "lesson": 13, "wk": true, "ex": { "no": "Støvlene tar jeg gjerne.", "de": "Die Stiefel nehme ich gern." } },
  { "id": "w13_skistovel", "no": "skistøvel", "de": "der Skischuh", "pos": "noun", "gender": "m", "forms": ["skistøvel", "skistøvelen", "skistøvler", "skistøvlene"], "lesson": 13, "wk": true, "ex": { "no": "Det er de gamle skistøvlene mine.", "de": "Das sind meine alten Skischuhe." } },
  { "id": "w13_vinterstovel", "no": "vinterstøvel", "de": "der Winterstiefel", "pos": "noun", "gender": "m", "forms": ["vinterstøvel", "vinterstøvelen", "vinterstøvler", "vinterstøvlene"], "lesson": 13, "wk": true, "ex": { "no": "I Tromsø trenger du gode vinterstøvler.", "de": "In Tromsø brauchst du gute Winterstiefel." } },
  { "id": "w13_joggesko", "no": "joggesko", "de": "der Turnschuh", "pos": "noun", "gender": "m", "forms": ["joggesko", "joggeskoen", "joggesko", "joggeskoene"], "lesson": 13, "wk": true, "ex": { "no": "Joggeskoene er for kalde om vinteren.", "de": "Die Turnschuhe sind im Winter zu kalt." } },
  { "id": "w13_toffel", "no": "tøffel", "de": "der Hausschuh", "pos": "noun", "gender": "m", "forms": ["tøffel", "tøffelen", "tøfler", "tøflene"], "lesson": 13, "wk": true, "note": "In Norwegen zieht man in der Wohnung die Schuhe aus – Hausschuhe oder Wollsocken sind wichtig.", "ex": { "no": "Hos Nygårds går alle i tøfler inne.", "de": "Bei Nygårds tragen drinnen alle Hausschuhe." } },
  { "id": "w13_belte", "no": "belte", "de": "der Gürtel", "pos": "noun", "gender": "n", "forms": ["belte", "beltet", "belter", "beltene"], "lesson": 13, "wk": true, "ex": { "no": "Buksa er for vid – jeg trenger et belte.", "de": "Die Hose ist zu weit – ich brauche einen Gürtel." } },
  { "id": "w13_veske", "no": "veske", "de": "die Tasche, die Handtasche", "pos": "noun", "gender": "f", "forms": ["veske", "veska", "vesker", "veskene"], "lesson": 13, "wk": true, "ex": { "no": "Er dette veska di?", "de": "Ist das deine Tasche?" } },
  { "id": "w13_ski", "no": "ski", "de": "der Ski", "pos": "noun", "gender": "m", "forms": ["ski", "skien", "ski", "skiene"], "lesson": 13, "note": "Auch: ei ski – skia. Plural ohne Endung: et par ski.", "ex": { "no": "Det er jo skiene mine!", "de": "Das sind ja meine Ski!" } },
  { "id": "w13_gaa_paa_ski", "no": "gå på ski", "de": "Ski fahren (Langlauf)", "pos": "phrase", "lesson": 13, "ex": { "no": "Om vinteren går vi på ski hver søndag.", "de": "Im Winter fahren wir jeden Sonntag Ski." } },
  { "id": "w13_storrelse", "no": "størrelse", "de": "die Größe", "pos": "noun", "gender": "m", "forms": ["størrelse", "størrelsen", "størrelser", "størrelsene"], "lesson": 13, "wk": true, "ex": { "no": "Hvilken størrelse bruker du?", "de": "Welche Größe trägst du?" } },
  { "id": "w13_skostorrelse", "no": "skostørrelse", "de": "die Schuhgröße", "pos": "noun", "gender": "m", "forms": ["skostørrelse", "skostørrelsen", "skostørrelser", "skostørrelsene"], "lesson": 13, "wk": true, "ex": { "no": "Vi har samme skostørrelse.", "de": "Wir haben dieselbe Schuhgröße." } },
  { "id": "w13_proverom", "no": "prøverom", "de": "die Umkleidekabine", "pos": "noun", "gender": "n", "forms": ["prøverom", "prøverommet", "prøverom", "prøveromma/prøverommene"], "lesson": 13, "wk": true, "ex": { "no": "Hvor er prøverommet?", "de": "Wo ist die Umkleidekabine?" } },
  { "id": "w13_ull", "no": "ull", "de": "die Wolle", "pos": "noun", "gender": "f", "forms": ["ull", "ulla"], "lesson": 13, "wk": true, "ex": { "no": "Det er ekte norsk ull.", "de": "Das ist echte norwegische Wolle." } },
  { "id": "w13_dun", "no": "dun", "de": "die Daunen", "pos": "noun", "gender": "n", "forms": ["dun", "dunet"], "lesson": 13, "wk": true, "ex": { "no": "Det er ekte dun i jakka.", "de": "In der Jacke sind echte Daunen." } },
  { "id": "w13_bomull", "no": "bomull", "de": "die Baumwolle", "pos": "noun", "gender": "f", "forms": ["bomull", "bomulla"], "lesson": 13, "wk": true, "ex": { "no": "Bomull blir kald når den er våt.", "de": "Baumwolle wird kalt, wenn sie nass ist." } },
  { "id": "w13_monster", "no": "mønster", "de": "das Muster", "pos": "noun", "gender": "n", "forms": ["mønster", "mønsteret", "mønstre", "mønstrene"], "lesson": 13, "wk": true, "ex": { "no": "Genseren har et fint mønster.", "de": "Der Pullover hat ein schönes Muster." } },
  { "id": "w13_hull", "no": "hull", "de": "das Loch", "pos": "noun", "gender": "n", "forms": ["hull", "hullet", "hull", "hulla/hullene"], "lesson": 13, "wk": true, "ex": { "no": "Det er et lite hull i lomma.", "de": "In der Tasche ist ein kleines Loch." } },
  { "id": "w13_lomme", "no": "lomme", "de": "die Tasche (an der Kleidung)", "pos": "noun", "gender": "f", "forms": ["lomme", "lomma", "lommer", "lommene"], "lesson": 13, "wk": true, "ex": { "no": "Nøklene ligger i lomma mi.", "de": "Die Schlüssel sind in meiner Tasche." } },
  { "id": "w13_glidelaas", "no": "glidelås", "de": "der Reißverschluss", "pos": "noun", "gender": "m", "forms": ["glidelås", "glidelåsen", "glidelåser", "glidelåsene"], "lesson": 13, "wk": true, "ex": { "no": "Glidelåsen på jakka er ødelagt.", "de": "Der Reißverschluss an der Jacke ist kaputt." } },
  { "id": "w13_knapp", "no": "knapp", "de": "der Knopf", "pos": "noun", "gender": "m", "forms": ["knapp", "knappen", "knapper", "knappene"], "lesson": 13, "wk": true, "note": "Falscher Freund: knapp = Knopf, nicht »knapp«.", "ex": { "no": "Det mangler en knapp på skjorta.", "de": "An dem Hemd fehlt ein Knopf." } },
  { "id": "w13_tynn", "no": "tynn", "de": "dünn", "pos": "adj", "forms": ["tynn", "tynt", "tynne"], "lesson": 13, "wk": true, "ex": { "no": "Jakka er altfor tynn for Tromsø.", "de": "Die Jacke ist viel zu dünn für Tromsø." } },
  { "id": "w13_tykk", "no": "tykk", "de": "dick", "pos": "adj", "forms": ["tykk", "tykt", "tykke"], "lesson": 13, "wk": true, "ex": { "no": "Jeg trenger et tykt skjerf.", "de": "Ich brauche einen dicken Schal." } },
  { "id": "w13_trang", "no": "trang", "de": "eng", "pos": "adj", "forms": ["trang", "trangt", "trange"], "lesson": 13, "wk": true, "ex": { "no": "Buksa er for trang i livet.", "de": "Die Hose ist an der Taille zu eng." } },
  { "id": "w13_vid", "no": "vid", "de": "weit", "pos": "adj", "forms": ["vid", "vidt", "vide"], "lesson": 13, "wk": true, "ex": { "no": "Genseren er altfor vid.", "de": "Der Pullover ist viel zu weit." } },
  { "id": "w13_slitt", "no": "slitt", "de": "abgetragen, abgenutzt", "pos": "adj", "forms": ["slitt", "slitt", "slitte"], "lesson": 13, "wk": true, "ex": { "no": "Den er litt slitt, men helt grei.", "de": "Er ist etwas abgetragen, aber ganz in Ordnung." } },
  { "id": "w13_brukt", "no": "brukt", "de": "gebraucht", "pos": "adj", "forms": ["brukt", "brukt", "brukte"], "lesson": 13, "ex": { "no": "Jeg har kjøpt den brukt.", "de": "Ich habe ihn gebraucht gekauft." } },
  { "id": "w13_fattig", "no": "fattig", "de": "arm", "pos": "adj", "forms": ["fattig", "fattig", "fattige"], "lesson": 13, "ex": { "no": "Jeg er bare en fattig student.", "de": "Ich bin nur eine arme Studentin." } },
  { "id": "w13_sur", "no": "sur", "de": "sauer", "deAlt": ["schlecht gelaunt", "verärgert"], "pos": "adj", "forms": ["sur", "surt", "sure"], "lesson": 13, "note": "Wie im Deutschen: sauer (Geschmack) und schlecht gelaunt.", "ex": { "no": "Mamma kommer til å bli sur.", "de": "Mama wird sauer sein." } },
  { "id": "w13_oransje", "no": "oransje", "de": "orange", "pos": "adj", "forms": ["oransje", "oransje", "oransje"], "lesson": 13, "wk": true, "note": "Unveränderlich, wie rosa und lilla.", "ex": { "no": "Anorakken er grønn og oransje.", "de": "Der Anorak ist grün und orange." } },
  { "id": "w13_rosa", "no": "rosa", "de": "rosa", "pos": "adj", "forms": ["rosa", "rosa", "rosa"], "lesson": 13, "wk": true, "note": "Unveränderlich: et rosa skjerf.", "ex": { "no": "Jeg har aldri hatt et rosa skjerf.", "de": "Ich hatte noch nie einen rosa Schal." } },
  { "id": "w13_halv", "no": "halv", "de": "halb", "pos": "adj", "forms": ["halv", "halvt", "halve"], "lesson": 13, "note": "halve + bestimmtes Substantiv: halve huset = das halbe Haus.", "ex": { "no": "Halve huset vårt står her!", "de": "Unser halbes Haus steht hier!" } },
  { "id": "w13_papegoye", "no": "papegøye", "de": "der Papagei", "pos": "noun", "gender": "m", "forms": ["papegøye", "papegøyen", "papegøyer", "papegøyene"], "lesson": 13, "ex": { "no": "Jeg vil ikke se ut som en papegøye.", "de": "Ich will nicht wie ein Papagei aussehen." } },
  { "id": "w13_i_paaskefjellet", "no": "i påskefjellet", "de": "zu Ostern in den Bergen", "pos": "phrase", "lesson": 13, "note": "Zu Ostern fahren viele Norweger zum Skilaufen in die Berge (påskefjellet).", "ex": { "no": "Per gikk alltid i anorakk i påskefjellet.", "de": "Per trug zu Ostern in den Bergen immer einen Anorak." } },
  { "id": "w13_egentlig", "no": "egentlig", "de": "eigentlich", "pos": "adv", "lesson": 13, "ex": { "no": "Hva trenger du egentlig?", "de": "Was brauchst du eigentlich?" } },
  { "id": "w13_visst", "no": "visst", "de": "wohl, anscheinend", "pos": "adv", "lesson": 13, "ex": { "no": "Pappa tok visst feil pose.", "de": "Papa hat wohl die falsche Tüte erwischt." } },
  { "id": "w13_uansett", "no": "uansett", "de": "egal, jedenfalls", "pos": "adv", "lesson": 13, "note": "uansett hvem/hva = egal wer/was", "ex": { "no": "Jeg kjøper jakka uansett hva den koster.", "de": "Ich kaufe die Jacke, egal, was sie kostet." } },
  { "id": "w13_saerlig", "no": "særlig", "de": "besonders", "pos": "adv", "lesson": 13, "ex": { "no": "Folk pruter særlig mot slutten av dagen.", "de": "Die Leute handeln besonders gegen Ende des Tages." } },
  { "id": "w13_der_borte", "no": "der borte", "de": "da drüben", "pos": "phrase", "lesson": 13, "ex": { "no": "Hva koster genseren der borte?", "de": "Was kostet der Pullover da drüben?" } },
  { "id": "w13_ved_siden_av", "no": "ved siden av", "de": "neben, daneben", "pos": "phrase", "lesson": 13, "ex": { "no": "Skistøvlene står ved siden av skiene.", "de": "Die Skischuhe stehen neben den Ski." } },
  { "id": "w13_nesten_som_ny", "no": "nesten som ny", "de": "fast wie neu", "pos": "phrase", "lesson": 13, "wk": true, "ex": { "no": "Jakka er nesten som ny.", "de": "Die Jacke ist fast wie neu." } },
  { "id": "w13_kjore", "no": "kjøre", "de": "fahren", "pos": "verb", "vf": ["kjører", "kjørte", "kjørt", "kjør"], "vg": "2", "lesson": 13, "note": "kjøre = (selbst) fahren; auch: mit dem Auto bringen.", "ex": { "no": "Pappa kjørte posene våre til skolen.", "de": "Papa hat unsere Tüten zur Schule gefahren." } },
  { "id": "w13_tilbake", "no": "tilbake", "de": "zurück", "pos": "adv", "lesson": 13, "ex": { "no": "Det skjerfet vil jeg ha tilbake!", "de": "Den Schal will ich zurückhaben!" } },
  { "id": "w13_absolutt", "no": "absolutt", "de": "absolut, unbedingt", "deAlt": ["absolut", "unbedingt"], "pos": "adv", "lesson": 13, "ex": { "no": "Er jakka varm nok? – Absolutt!", "de": "Ist die Jacke warm genug? – Absolut!" } },
  { "id": "w13_derfor", "no": "derfor", "de": "deshalb, darum", "deAlt": ["deshalb", "darum"], "pos": "adv", "lesson": 13, "note": "Adverb: Am Satzanfang folgt Inversion – Derfor selger foreldrene lodd.", "ex": { "no": "Korpset trenger penger. Derfor har de loppemarked.", "de": "Die Kapelle braucht Geld. Deshalb veranstaltet sie einen Flohmarkt." } },
  { "id": "w13_skole", "no": "skole", "de": "die Schule", "pos": "noun", "gender": "m", "forms": ["skole", "skolen", "skoler", "skolene"], "lesson": 13, "ex": { "no": "Ola tar bussen til skolen.", "de": "Ola fährt mit dem Bus zur Schule." } },
  { "id": "w13_vaar_fruehling", "no": "vår", "de": "der Frühling", "pos": "noun", "gender": "m", "forms": ["vår", "våren", "vårer", "vårene"], "lesson": 13, "note": "om våren = im Frühling. Nicht verwechseln mit vår = unser.", "ex": { "no": "Om våren har borettslaget dugnad.", "de": "Im Frühling hat die Wohnungsgenossenschaft einen Arbeitseinsatz." } },
  { "id": "w13_arbeid", "no": "arbeid", "de": "die Arbeit", "pos": "noun", "gender": "n", "forms": ["arbeid", "arbeidet", "arbeid", "arbeida/arbeidene"], "lesson": 13, "ex": { "no": "Dugnad er frivillig arbeid.", "de": "Dugnad ist freiwillige Arbeit." } },
  { "id": "w13_hjelp", "no": "hjelp", "de": "die Hilfe", "pos": "noun", "gender": "m", "forms": ["hjelp", "hjelpen"], "lesson": 13, "ex": { "no": "Takk for hjelpen!", "de": "Danke für die Hilfe!" } },
  { "id": "w13_forrige", "no": "forrige", "de": "vorige, letzte", "deAlt": ["vorige", "letzte"], "pos": "adj", "forms": ["forrige", "forrige", "forrige"], "lesson": 13, "note": "Unveränderlich: i forrige uke = letzte Woche, forrige år = letztes Jahr.", "ex": { "no": "Pappa kjørte posene hit i forrige uke.", "de": "Papa hat die Tüten letzte Woche hergefahren." } },
  { "id": "w13_mai", "no": "mai", "de": "der Mai", "pos": "name", "lesson": 13, "note": "Monatsnamen schreibt man klein: i mai, 17. mai (syttende mai).", "ex": { "no": "Den 17. mai går korpset i barnetoget.", "de": "Am 17. Mai marschiert die Kapelle im Kinderumzug mit." } },
  { "id": "w13_orkester", "no": "orkester", "de": "das Orchester", "pos": "noun", "gender": "n", "forms": ["orkester", "orkesteret", "orkestre/orkester", "orkestrene"], "lesson": 13, "ex": { "no": "Et skolekorps er et orkester for barn og unge.", "de": "Ein skolekorps ist ein Orchester für Kinder und Jugendliche." } },
  { "id": "w13_instrument", "no": "instrument", "de": "das Instrument", "pos": "noun", "gender": "n", "forms": ["instrument", "instrumentet", "instrumenter", "instrumenta/instrumentene"], "lesson": 13, "ex": { "no": "Spiller du et instrument?", "de": "Spielst du ein Instrument?" } },
  { "id": "w13_kjop", "no": "kjøp", "de": "der Kauf", "pos": "noun", "gender": "n", "forms": ["kjøp", "kjøpet", "kjøp", "kjøpa/kjøpene"], "lesson": 13, "note": "med på kjøpet = gratis dazu", "ex": { "no": "Det var et godt kjøp.", "de": "Das war ein guter Kauf." } },
  { "id": "w13_benk", "no": "benk", "de": "die Bank (zum Sitzen)", "pos": "noun", "gender": "m", "forms": ["benk", "benken", "benker", "benkene"], "lesson": 13, "ex": { "no": "På dugnaden maler vi benkene i hagen.", "de": "Beim Arbeitseinsatz streichen wir die Bänke im Garten." } },
  { "id": "w13_grille", "no": "grille", "de": "grillen", "pos": "verb", "vf": ["griller", "grillet", "grillet", "grill"], "vg": "1", "lesson": 13, "ex": { "no": "Etter dugnaden griller vi pølser.", "de": "Nach dem Arbeitseinsatz grillen wir Würstchen." } }
]
