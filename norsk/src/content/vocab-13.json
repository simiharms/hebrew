  { "id": "w13_strikkejakke", "no": "strikkejakke", "de": "die Strickjacke", "pos": "noun", "gender": "f", "forms": ["strikkejakke", "strikkejakka", "strikkejakker", "strikkejakkene"], "lesson": 13, "wk": true, "ex": { "no": "Bestemor har strikket ei strikkejakke til meg.", "de": "Oma hat mir eine Strickjacke gestrickt." } },
