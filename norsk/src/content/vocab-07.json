  { "id": "w07_kjenne", "no": "kjenne", "de": "kennen", "pos": "verb", "vf": ["kjenner", "kjente", "kjent", "kjenn"], "vg": "2", "lesson": 7, "ex": { "no": "Jeg kjenner en god pizzarestaurant.", "de": "Ich kenne eine gute Pizzeria." }, "note": "kjenne = Personen und Orte kennen; vite = wissen." },
