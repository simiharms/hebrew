  { "id": "w13_kaare", "no": "kåre", "de": "wählen, küren", "pos": "verb", "vf": ["kårer", "kåret", "kåret", "kår"], "vg": "1", "lesson": 13, "ex": { "no": "Seerne kåret dugnad til Norges nasjonalord.", "de": "Die Zuschauer kürten dugnad zum norwegischen Nationalwort." } },
  { "id": "w13_rake", "no": "rake", "de": "rechen, harken", "pos": "verb", "vf": ["raker", "raket", "raket", "rak"], "vg": "1", "lesson": 13, "ex": { "no": "Om våren raker vi løv i hagen.", "de": "Im Frühling rechen wir im Garten Laub." } },
  { "id": "w13_arrangere", "no": "arrangere", "de": "veranstalten, organisieren", "pos": "verb", "vf": ["arrangerer", "arrangerte", "arrangert", "arranger"], "vg": "2", "lesson": 13, "ex": { "no": "Korpset arrangerer et loppemarked.", "de": "Die Kapelle veranstaltet einen Flohmarkt." } },
  { "id": "w13_strikke", "no": "strikke", "de": "stricken", "pos": "verb", "vf": ["strikker", "strikket", "strikket", "strikk"], "vg": "1", "lesson": 13, "wk": true, "ex": { "no": "Den genseren har jeg strikket selv.", "de": "Den Pullover habe ich selbst gestrickt." } },
  { "id": "w13_kjenne_igjen", "no": "kjenne igjen", "de": "wiedererkennen", "pos": "verb", "vf": ["kjenner igjen", "kjente igjen", "kjent igjen", "kjenn igjen"], "vg": "2", "lesson": 13, "ex": { "no": "Anna kjente igjen jakka med en gang.", "de": "Anna hat die Jacke sofort wiedererkannt." } },
  { "id": "w13_se_ut_som", "no": "se ut som", "de": "aussehen wie", "pos": "phrase", "lesson": 13, "ex": { "no": "I den anorakken ser du ut som en papegøye!", "de": "In dem Anorak siehst du aus wie ein Papagei!" } },
  { "id": "w13_ha_paa_seg", "no": "ha på seg", "de": "anhaben, tragen", "pos": "verb", "vf": ["har på seg", "hadde på seg", "hatt på seg", "ha på deg"], "vg": "uregelm", "lesson": 13, "wk": true, "ex": { "no": "Hun hadde på seg en rød kjole.", "de": "Sie trug ein rotes Kleid." } },
