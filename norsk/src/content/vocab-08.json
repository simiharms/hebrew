[
  { "id": "w08_provokasjon", "no": "provokasjon", "de": "die Provokation", "pos": "noun", "gender": "m", "forms": ["provokasjon", "provokasjonen", "provokasjoner", "provokasjonene"], "lesson": 8, "ex": { "no": "Arne elsker en god provokasjon.", "de": "Arne liebt eine gute Provokation." } },
  { "id": "w08_besok", "no": "besøk", "de": "der Besuch", "pos": "noun", "gender": "n", "forms": ["besøk", "besøket", "besøk", "besøka/besøkene"], "lesson": 8, "ex": { "no": "Søndag fikk familien besøk fra Ålesund.", "de": "Am Sonntag bekam die Familie Besuch aus Ålesund." }, "note": "få besøk = Besuch bekommen; være på besøk = zu Besuch sein" },
  { "id": "w08_forskjellig", "no": "forskjellig", "de": "verschieden, unterschiedlich", "pos": "adj", "forms": ["forskjellig", "forskjellig", "forskjellige"], "lesson": 8, "ex": { "no": "Kari og Arne er veldig forskjellige.", "de": "Kari und Arne sind sehr verschieden." } },
  { "id": "w08_provosere", "no": "provosere", "de": "provozieren", "pos": "verb", "vf": ["provoserer", "provoserte", "provosert", "provoser"], "vg": "2", "lesson": 8, "ex": { "no": "Arne liker å provosere.", "de": "Arne provoziert gern." } },
  { "id": "w08_innerst_inne", "no": "innerst inne", "de": "im Grunde, tief im Innern", "pos": "phrase", "lesson": 8, "ex": { "no": "Han er snill innerst inne.", "de": "Im Grunde ist er lieb." } },
  { "id": "w08_middag", "no": "middag", "de": "die warme Hauptmahlzeit, das Abendessen", "deAlt": ["das Abendessen", "das Essen"], "pos": "noun", "gender": "m", "forms": ["middag", "middagen", "middager", "middagene"], "lesson": 8, "wk": true, "ex": { "no": "Vi spiser middag klokka fem.", "de": "Wir essen um fünf Uhr warm." }, "note": "Falscher Freund: middag ist die warme Mahlzeit am Nachmittag (meist 16–18 Uhr), nicht »Mittag«." },
  { "id": "w08_klokke", "no": "klokke", "de": "die Uhr", "pos": "noun", "gender": "f", "forms": ["klokke", "klokka/klokken", "klokker", "klokkene"], "lesson": 8, "ex": { "no": "Hvor mye er klokka?", "de": "Wie spät ist es?" }, "note": "Bei der Uhrzeit: klokka fem = um fünf (Uhr) – ohne Präposition." },
  { "id": "w08_kvart_over", "no": "kvart over", "de": "Viertel nach", "pos": "phrase", "lesson": 8, "ex": { "no": "Arne kom kvart over fem.", "de": "Arne kam um Viertel nach fünf." }, "note": "kvart på = Viertel vor. Eine Viertelstunde = et kvarter." },
  { "id": "w08_halv", "no": "halv", "de": "halb", "pos": "adj", "forms": ["halv", "halvt", "halve"], "lesson": 8, "ex": { "no": "Klokka er halv seks.", "de": "Es ist halb sechs." }, "note": "halv seks = halb sechs (5.30), wie im Deutschen. en halv time = eine halbe Stunde." },
  { "id": "w08_over", "no": "over", "de": "nach (bei der Uhrzeit); über", "deAlt": ["über", "nach"], "pos": "prep", "lesson": 8, "ex": { "no": "Klokka er ti over sju.", "de": "Es ist zehn nach sieben." }, "note": "Bei der Uhrzeit: over = nach, på = vor." },
  { "id": "w08_pose", "no": "pose", "de": "die Tüte", "pos": "noun", "gender": "m", "forms": ["pose", "posen", "poser", "posene"], "lesson": 8, "ex": { "no": "Trenger du en pose?", "de": "Brauchst du eine Tüte?" } },
  { "id": "w08_klippfisk", "no": "klippfisk", "de": "der Klippfisch (getrockneter Salzkabeljau)", "pos": "noun", "gender": "m", "forms": ["klippfisk", "klippfisken"], "lesson": 8, "ex": { "no": "Ålesund er kjent for klippfisk.", "de": "Ålesund ist für Klippfisch bekannt." } },
  { "id": "w08_presis", "no": "presis", "de": "pünktlich", "deAlt": ["genau", "präzise"], "pos": "adj", "forms": ["presis", "presist", "presise"], "lesson": 8, "ex": { "no": "Matthias er alltid presis.", "de": "Matthias ist immer pünktlich." }, "note": "presis klokka fem = pünktlich um fünf" },
  { "id": "w08_punktlig", "no": "punktlig", "de": "pünktlich", "pos": "adj", "forms": ["punktlig", "punktlig", "punktlige"], "lesson": 8, "ex": { "no": "Toget var punktlig i dag.", "de": "Der Zug war heute pünktlich." } },
  { "id": "w08_smile", "no": "smile", "de": "lächeln", "pos": "verb", "vf": ["smiler", "smilte", "smilt", "smil"], "vg": "2", "lesson": 8, "ex": { "no": "Susanne smilte til Arne.", "de": "Susanne lächelte Arne an." } },
  { "id": "w08_for_sent", "no": "for sent", "de": "zu spät", "pos": "phrase", "lesson": 8, "ex": { "no": "Jeg kom en halv time for sent til kurset.", "de": "Ich kam eine halbe Stunde zu spät zum Kurs." }, "note": "for = zu (zu viel): for sent, for dyrt, for kaldt" },
  { "id": "w08_le", "no": "le", "de": "lachen", "pos": "verb", "vf": ["ler", "lo", "ledd", "le"], "vg": "sterk", "lesson": 8, "ex": { "no": "Alle lo av Arne.", "de": "Alle lachten über Arne." } },
  { "id": "w08_gjore_store_oyne", "no": "gjøre store øyne", "de": "große Augen machen", "pos": "phrase", "lesson": 8, "ex": { "no": "Arne gjorde store øyne.", "de": "Arne machte große Augen." } },
  { "id": "w08_vaer_saa_god", "no": "vær så god", "de": "bitte schön; bitte zu Tisch", "pos": "phrase", "lesson": 8, "wk": true, "ex": { "no": "Vær så god, maten er klar!", "de": "Bitte zu Tisch, das Essen ist fertig!" }, "note": "Der Gastgeber bittet damit zu Tisch; auch beim Überreichen von etwas." },
  { "id": "w08_klar", "no": "klar", "de": "fertig, bereit", "deAlt": ["bereit", "klar"], "pos": "adj", "forms": ["klar", "klart", "klare"], "lesson": 8, "ex": { "no": "Maten er klar!", "de": "Das Essen ist fertig!" } },
  { "id": "w08_laks", "no": "laks", "de": "der Lachs", "pos": "noun", "gender": "m", "forms": ["laks", "laksen", "lakser", "laksene"], "lesson": 8, "wk": true, "ex": { "no": "Til middag var det laks og poteter.", "de": "Zum Essen gab es Lachs und Kartoffeln." } },
  { "id": "w08_tallerken", "no": "tallerken", "de": "der Teller", "pos": "noun", "gender": "m", "forms": ["tallerken", "tallerkenen", "tallerkener", "tallerkenene"], "lesson": 8, "wk": true, "ex": { "no": "Ola så på tallerkenen og sukket.", "de": "Ola sah auf seinen Teller und seufzte." } },
  { "id": "w08_sukke", "no": "sukke", "de": "seufzen", "pos": "verb", "vf": ["sukker", "sukket", "sukket", "sukk"], "vg": "1", "lesson": 8, "ex": { "no": "Hvorfor sukker du?", "de": "Warum seufzt du?" }, "note": "Nicht verwechseln: et sukker = der Zucker." },
  { "id": "w08_ungdom", "no": "ungdom", "de": "die Jugend; der/die Jugendliche", "deAlt": ["die Jugend", "der Jugendliche"], "pos": "noun", "gender": "m", "forms": ["ungdom", "ungdommen", "ungdommer", "ungdommene"], "lesson": 8, "ex": { "no": "Ungdommen i dag spiser lite fisk.", "de": "Die Jugend von heute isst wenig Fisch." } },
  { "id": "w08_olje", "no": "olje", "de": "das Öl", "pos": "noun", "gender": "m", "forms": ["olje", "oljen", "oljer", "oljene"], "lesson": 8, "ex": { "no": "Norge har mye olje i Nordsjøen.", "de": "Norwegen hat viel Öl in der Nordsee." } },
  { "id": "w08_oljepenger", "no": "oljepenger", "de": "das Ölgeld", "pos": "noun", "gender": "m", "forms": ["oljepenger", "oljepengene"], "lesson": 8, "ex": { "no": "Arne snakker om oljepengene.", "de": "Arne redet über das Ölgeld." }, "note": "Nur Plural, wie penger (Geld)." },
  { "id": "w08_begynne", "no": "begynne", "de": "anfangen, beginnen", "pos": "verb", "vf": ["begynner", "begynte", "begynt", "begynn"], "vg": "2", "lesson": 8, "ex": { "no": "Middagen begynner klokka fem.", "de": "Das Essen beginnt um fünf Uhr." } },
  { "id": "w08_gaffel", "no": "gaffel", "de": "die Gabel", "pos": "noun", "gender": "m", "forms": ["gaffel", "gaffelen", "gafler", "gaflene"], "lesson": 8, "wk": true, "ex": { "no": "Susanne la fra seg gaffelen.", "de": "Susanne legte die Gabel weg." }, "note": "Plural ohne e: gafler (mehr dazu in Lektion 9)." },
  { "id": "w08_kniv", "no": "kniv", "de": "das Messer", "pos": "noun", "gender": "m", "forms": ["kniv", "kniven", "kniver", "knivene"], "lesson": 8, "wk": true, "ex": { "no": "Kan jeg få en kniv?", "de": "Kann ich ein Messer bekommen?" } },
  { "id": "w08_skje", "no": "skje", "de": "der Löffel", "pos": "noun", "gender": "f", "forms": ["skje", "skjea/skjeen", "skjeer", "skjeene"], "lesson": 8, "wk": true, "ex": { "no": "Suppe spiser man med skje.", "de": "Suppe isst man mit dem Löffel." } },
  { "id": "w08_legge_fra_seg", "no": "legge fra seg", "de": "weglegen, hinlegen", "pos": "verb", "vf": ["legger fra seg", "la fra seg", "lagt fra seg", "legg fra deg"], "vg": "uregelm", "lesson": 8, "ex": { "no": "Legg fra deg telefonen når vi spiser!", "de": "Leg das Handy weg, wenn wir essen!" } },
  { "id": "w08_betale", "no": "betale", "de": "bezahlen", "pos": "verb", "vf": ["betaler", "betalte", "betalt", "betal"], "vg": "2", "lesson": 8, "ex": { "no": "Susanne betaler husleie til Kari.", "de": "Susanne bezahlt Kari Miete." } },
  { "id": "w08_husleie", "no": "husleie", "de": "die Miete", "pos": "noun", "gender": "f", "forms": ["husleie", "husleia/husleien", "husleier", "husleiene"], "lesson": 8, "ex": { "no": "Husleia er høy i Oslo.", "de": "Die Miete in Oslo ist hoch." } },
  { "id": "w08_eneste", "no": "eneste", "de": "einzig", "pos": "adj", "forms": ["eneste", "eneste", "eneste"], "lesson": 8, "ex": { "no": "Jeg har ikke fått en eneste krone.", "de": "Ich habe keine einzige Krone bekommen." }, "note": "Unveränderlich." },
  { "id": "w08_saus", "no": "saus", "de": "die Soße", "pos": "noun", "gender": "m", "forms": ["saus", "sausen", "sauser", "sausene"], "lesson": 8, "wk": true, "ex": { "no": "Hvem vil ha saus?", "de": "Wer möchte Soße?" } },
  { "id": "w08_dessert", "no": "dessert", "de": "der Nachtisch, das Dessert", "deAlt": ["der Nachtisch", "das Dessert"], "pos": "noun", "gender": "m", "forms": ["dessert", "desserten", "desserter", "dessertene"], "lesson": 8, "wk": true, "ex": { "no": "Til dessert er det eplekake.", "de": "Zum Nachtisch gibt es Apfelkuchen." } },
  { "id": "w08_eplekake", "no": "eplekake", "de": "der Apfelkuchen", "pos": "noun", "gender": "f", "forms": ["eplekake", "eplekaka/eplekaken", "eplekaker", "eplekakene"], "lesson": 8, "wk": true, "ex": { "no": "Susanne bakte en eplekake på lørdag.", "de": "Susanne hat am Samstag einen Apfelkuchen gebacken." } },
  { "id": "w08_bake", "no": "bake", "de": "backen", "pos": "verb", "vf": ["baker", "bakte", "bakt", "bak"], "vg": "2", "lesson": 8, "ex": { "no": "Susanne elsker å bake.", "de": "Susanne bäckt sehr gern." } },
  { "id": "w08_faktisk", "no": "faktisk", "de": "tatsächlich, eigentlich", "pos": "adv", "lesson": 8, "ex": { "no": "Kaka er faktisk veldig god.", "de": "Der Kuchen ist tatsächlich sehr gut." } },
  { "id": "w08_ikke_saa_verst", "no": "ikke så verst", "de": "gar nicht so schlecht", "pos": "phrase", "lesson": 8, "ex": { "no": "Kaka var faktisk ikke så verst.", "de": "Der Kuchen war tatsächlich gar nicht so schlecht." }, "note": "Typisch norwegisches Understatement – oft ein Lob!" },
  { "id": "w08_kjaerlighetserklaering", "no": "kjærlighetserklæring", "de": "die Liebeserklärung", "pos": "noun", "gender": "m", "forms": ["kjærlighetserklæring", "kjærlighetserklæringen", "kjærlighetserklæringer", "kjærlighetserklæringene"], "lesson": 8, "ex": { "no": "Fra Arne er det nesten en kjærlighetserklæring.", "de": "Von Arne ist das fast eine Liebeserklärung." } },
  { "id": "w08_reise_seg", "no": "reise seg", "de": "aufstehen (vom Tisch, vom Stuhl)", "pos": "verb", "vf": ["reiser seg", "reiste seg", "reist seg", "reis deg"], "vg": "2", "lesson": 8, "ex": { "no": "Klokka sju reiste Ola seg fra bordet.", "de": "Um sieben stand Ola vom Tisch auf." }, "note": "Morgens aus dem Bett: stå opp." },
  { "id": "w08_takk_for_maten", "no": "takk for maten", "de": "danke für das Essen", "pos": "phrase", "lesson": 8, "wk": true, "ex": { "no": "Takk for maten, Kari!", "de": "Danke für das Essen, Kari!" }, "note": "Sagt man nach jeder Mahlzeit – auch zu Hause in der Familie." },
  { "id": "w08_velbekomme", "no": "velbekomme", "de": "wohl bekomm's", "pos": "interj", "lesson": 8, "wk": true, "ex": { "no": "Takk for maten! – Velbekomme!", "de": "Danke für das Essen! – Wohl bekomm's!" }, "note": "Die Antwort auf »Takk for maten«." },
  { "id": "w08_lekse", "no": "lekse", "de": "die Hausaufgabe", "pos": "noun", "gender": "f", "forms": ["lekse", "leksa/leksen", "lekser", "leksene"], "lesson": 8, "ex": { "no": "Ola må gjøre lekser.", "de": "Ola muss Hausaufgaben machen." }, "note": "gjøre lekser = Hausaufgaben machen" },
  { "id": "w08_taxi", "no": "taxi", "de": "das Taxi", "pos": "noun", "gender": "m", "forms": ["taxi", "taxien", "taxier", "taxiene"], "lesson": 8, "ex": { "no": "Taxien kommer om et kvarter.", "de": "Das Taxi kommt in einer Viertelstunde." } },
  { "id": "w08_ringe_etter", "no": "ringe etter", "de": "(telefonisch) rufen, bestellen", "pos": "phrase", "lesson": 8, "ex": { "no": "Kan du ringe etter en taxi?", "de": "Kannst du ein Taxi rufen?" } },
  { "id": "w08_takk_for_i_kveld", "no": "takk for i kveld", "de": "danke für den (schönen) Abend", "pos": "phrase", "lesson": 8, "wk": true, "ex": { "no": "Takk for i kveld, det var veldig hyggelig!", "de": "Danke für den Abend, es war sehr schön!" } },
  { "id": "w08_grei", "no": "grei", "de": "nett, in Ordnung, unkompliziert", "deAlt": ["nett", "in Ordnung", "unkompliziert"], "pos": "adj", "forms": ["grei", "greit", "greie"], "lesson": 8, "ex": { "no": "Arne er grei innerst inne.", "de": "Im Grunde ist Arne in Ordnung." }, "note": "Det er greit! = Das ist in Ordnung! / Okay!" },
  { "id": "w08_for_aa_vaere", "no": "for å være", "de": "für (jemanden, der … ist)", "pos": "phrase", "lesson": 8, "ex": { "no": "Han snakker godt norsk for å være sveitser.", "de": "Für einen Schweizer spricht er gut Norwegisch." } },
  { "id": "w08_legge_seg", "no": "legge seg", "de": "ins Bett gehen, sich hinlegen", "pos": "verb", "vf": ["legger seg", "la seg", "lagt seg", "legg deg"], "vg": "uregelm", "lesson": 8, "ex": { "no": "Klokka elleve gikk Susanne og la seg.", "de": "Um elf ging Susanne ins Bett." } },
  { "id": "w08_trott", "no": "trøtt", "de": "müde", "pos": "adj", "forms": ["trøtt", "trøtt", "trøtte"], "lesson": 8, "ex": { "no": "Etter middagen var alle trøtte.", "de": "Nach dem Essen waren alle müde." } },
  { "id": "w08_fornoyd", "no": "fornøyd", "de": "zufrieden", "pos": "adj", "forms": ["fornøyd", "fornøyd", "fornøyde"], "lesson": 8, "ex": { "no": "Kari var fornøyd med kvelden.", "de": "Kari war mit dem Abend zufrieden." } },
  { "id": "w08_gi", "no": "gi", "de": "geben", "pos": "verb", "vf": ["gir", "ga/gav", "gitt", "gi"], "vg": "sterk", "lesson": 8, "ex": { "no": "Arne ga Kari en pose klippfisk.", "de": "Arne gab Kari eine Tüte Klippfisch." } },
  { "id": "w08_drikke", "no": "drikke", "de": "trinken", "pos": "verb", "vf": ["drikker", "drakk", "drukket", "drikk"], "vg": "sterk", "lesson": 8, "ex": { "no": "Arne drakk to glass vin.", "de": "Arne trank zwei Gläser Wein." } },
  { "id": "w08_sitte", "no": "sitte", "de": "sitzen", "pos": "verb", "vf": ["sitter", "satt", "sittet", "sitt"], "vg": "sterk", "lesson": 8, "ex": { "no": "Vi satt ved bordet i tre timer.", "de": "Wir saßen drei Stunden am Tisch." } },
  { "id": "w08_ligge", "no": "ligge", "de": "liegen", "pos": "verb", "vf": ["ligger", "lå", "ligget", "ligg"], "vg": "sterk", "lesson": 8, "ex": { "no": "Bamse lå under bordet.", "de": "Bamse lag unter dem Tisch." } },
  { "id": "w08_vite", "no": "vite", "de": "wissen", "pos": "verb", "vf": ["vet", "visste", "visst", ""], "vg": "uregelm", "lesson": 8, "ex": { "no": "Arne visste ikke hva han skulle si.", "de": "Arne wusste nicht, was er sagen sollte." }, "note": "vite = wissen; kjenne = kennen." },
  { "id": "w08_sporre", "no": "spørre", "de": "fragen", "pos": "verb", "vf": ["spør", "spurte", "spurt", "spør"], "vg": "uregelm", "lesson": 8, "ex": { "no": "Susanne spurte Arne om Ålesund.", "de": "Susanne fragte Arne nach Ålesund." } },
  { "id": "w08_svare", "no": "svare", "de": "antworten", "pos": "verb", "vf": ["svarer", "svarte", "svart", "svar"], "vg": "2", "lesson": 8, "ex": { "no": "Susanne svarte høflig, men bestemt.", "de": "Susanne antwortete höflich, aber bestimmt." } },
  { "id": "w08_svar", "no": "svar", "de": "die Antwort", "pos": "noun", "gender": "n", "forms": ["svar", "svaret", "svar", "svara/svarene"], "lesson": 8, "ex": { "no": "Svaret er «Velbekomme».", "de": "Die Antwort ist »Velbekomme«." } },
  { "id": "w08_hoflig", "no": "høflig", "de": "höflich", "pos": "adj", "forms": ["høflig", "høflig", "høflige"], "lesson": 8, "ex": { "no": "Det er høflig å si «Takk for maten».", "de": "Es ist höflich, »Takk for maten« zu sagen." } },
  { "id": "w08_bestemt", "no": "bestemt", "de": "bestimmt, entschieden", "pos": "adj", "forms": ["bestemt", "bestemt", "bestemte"], "lesson": 8, "ex": { "no": "Susanne var høflig, men bestemt.", "de": "Susanne war höflich, aber bestimmt." } },
  { "id": "w08_time", "no": "time", "de": "die Stunde", "pos": "noun", "gender": "m", "forms": ["time", "timen", "timer", "timene"], "lesson": 8, "ex": { "no": "De satt ved bordet i tre timer.", "de": "Sie saßen drei Stunden am Tisch." }, "note": "Falscher Freund: time = Stunde (auch Unterrichtsstunde); Zeit = tid." },
  { "id": "w08_halvtime", "no": "halvtime", "de": "die halbe Stunde", "pos": "noun", "gender": "m", "forms": ["halvtime", "halvtimen", "halvtimer", "halvtimene"], "lesson": 8, "ex": { "no": "Lunsjpausen er bare en halvtime.", "de": "Die Mittagspause dauert nur eine halbe Stunde." }, "note": "Auch getrennt: en halv time." },
  { "id": "w08_minutt", "no": "minutt", "de": "die Minute", "pos": "noun", "gender": "n", "forms": ["minutt", "minuttet", "minutter", "minuttene/minutta"], "lesson": 8, "ex": { "no": "Maten er klar om ti minutter.", "de": "Das Essen ist in zehn Minuten fertig." } },
  { "id": "w08_for_siden", "no": "for … siden", "de": "vor (zeitlich)", "pos": "phrase", "lesson": 8, "ex": { "no": "Arne kom for to timer siden.", "de": "Arne kam vor zwei Stunden." }, "note": "Der Zeitraum steht in der Mitte: for to år siden = vor zwei Jahren." },
  { "id": "w08_om", "no": "om", "de": "in (zeitlich, Zukunft)", "deAlt": ["in"], "pos": "prep", "lesson": 8, "ex": { "no": "Toget går om fem minutter.", "de": "Der Zug fährt in fünf Minuten." }, "note": "om + Zeitraum = in (Zukunft); om morgenen = morgens. Sonst auch: über, ob." },
  { "id": "w08_morgen", "no": "morgen", "de": "der Morgen", "pos": "noun", "gender": "m", "forms": ["morgen", "morgenen", "morgener", "morgenene"], "lesson": 8, "ex": { "no": "Om morgenen drikker Per kaffe.", "de": "Morgens trinkt Per Kaffee." }, "note": "i morgen = morgen (Tag); om morgenen = morgens; i morges = heute früh" },
  { "id": "w08_formiddag", "no": "formiddag", "de": "der Vormittag", "pos": "noun", "gender": "m", "forms": ["formiddag", "formiddagen", "formiddager", "formiddagene"], "lesson": 8, "ex": { "no": "Om formiddagen er Kari på jobb.", "de": "Vormittags ist Kari bei der Arbeit." } },
  { "id": "w08_ettermiddag", "no": "ettermiddag", "de": "der Nachmittag", "pos": "noun", "gender": "m", "forms": ["ettermiddag", "ettermiddagen", "ettermiddager", "ettermiddagene"], "lesson": 8, "ex": { "no": "Vi spiser middag om ettermiddagen.", "de": "Wir essen am Nachmittag warm." } },
