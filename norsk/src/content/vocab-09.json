  { "id": "w09_kontor", "no": "kontor", "de": "das Büro", "pos": "noun", "gender": "n", "forms": ["kontor", "kontoret", "kontorer", "kontorene/kontora"], "lesson": 9, "ex": { "no": "Det nye kontoret ligger i et høyhus.", "de": "Das neue Büro liegt in einem Hochhaus." } },
