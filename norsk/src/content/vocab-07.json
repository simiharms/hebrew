  { "id": "w07_verden", "no": "verden", "de": "die Welt", "pos": "noun", "gender": "m", "forms": ["verden", "verden"], "lesson": 7, "ex": { "no": "Ibsen er kjent over hele verden.", "de": "Ibsen ist auf der ganzen Welt bekannt." }, "note": "Die bestimmte Form hat keine Endung: verden = die Welt." },
